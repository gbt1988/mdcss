.markdown-here-wrapper {
  color: #2a2a2a;
  font-size: 16.5px;
  line-height: 1.75;
  padding: 8px 6px;
  box-sizing: border-box;
}

.markdown-here-wrapper p {
  letter-spacing: 0.2px !important;
  line-height: 1.75 !important;
  min-height: 1em !important;
  box-sizing: border-box !important;
  word-wrap: break-word !important;
  text-align: justify;
  margin: 18px 0 !important;
}

.markdown-here-wrapper blockquote {
  background: #f9f9f9;
  border-left: 5px solid #6FA8E8;
  margin: 1.5em 0;
  padding: 0.55em 12px;
  quotes: "\201C""\201D""\2018""\2019";
}

.markdown-here-wrapper blockquote:before {
  color: #6FA8E8;
  content: open-quote;
  font-size: 3.6em;
  line-height: 0.1em;
  margin-right: 0.2em;
  vertical-align: -0.42em;
}

.markdown-here-wrapper blockquote p {
  display: inline;
}

.markdown-here-wrapper strong {
  font-weight: 600;
  color: #B86A3C;
}

.markdown-here-wrapper em,
.markdown-here-wrapper i {
  color: #7A6FA8;
  font-style: italic;
}

.markdown-here-wrapper h1,
.markdown-here-wrapper h2,
.markdown-here-wrapper h3,
.markdown-here-wrapper h4,
.markdown-here-wrapper h5,
.markdown-here-wrapper h6 {
  margin: 22px 0 14px;
  line-height: 1.25;
  text-align: left;
  font-weight: 700;
  padding-left: 10px;
  background: transparent !important;
  text-shadow: none !important;
  box-shadow: none !important;
  word-break: break-word;
  overflow-wrap: break-word;
  color: #222222;
}

/* 三色体系：暖红 / 青绿 / 清透蓝 */
.markdown-here-wrapper h1 {
  border-left: 6px solid #D96C6C !important;
  font-size: 24px !important;
}

.markdown-here-wrapper h2 {
  border-left: 4px solid #58A889 !important;
  font-size: 20px !important;
}

.markdown-here-wrapper h3 {
  border-left: 4px solid #6FA8E8 !important;
  font-size: 17px !important;
}

.markdown-here-wrapper h4 {
  border-left: 4px solid #6FA8E8 !important;
  font-size: 15px !important;
}

.markdown-here-wrapper h5 {
  border-left: 4px solid #58A889 !important;
  font-size: 15px !important;
}

.markdown-here-wrapper h6 {
  border-left: 4px solid #6FA8E8 !important;
  font-size: 15px !important;
}

.markdown-here-wrapper a {
  color: #4E86C8 !important;
  text-decoration: none !important;
}

.markdown-here-wrapper ul,
.markdown-here-wrapper ol {
  padding-left: 30px;
}

.markdown-here-wrapper li {
  line-height: 24px;
  margin: 4px 0;
}

.markdown-here-wrapper hr {
  height: 4px;
  padding: 0;
  margin: 18px 0;
  background-color: #e7e7e7;
  border: 0 none;
  overflow: hidden;
  box-sizing: content-box;
  border-bottom: 1px solid #ddd;
}

.markdown-here-wrapper pre {
  background: #f8f8f8 !important;
  border: 1px solid #eaeaea;
  border-radius: 4px;
  padding: 12px 13px;
  font-size: 13px;
  line-height: 1.6;
  color: #666;
  overflow: auto;
  white-space: pre;
}

.markdown-here-wrapper img {
  max-width: 100%;
  height: auto;
  border: 1px solid #d8d8d8;
  padding: 2px;
  outline-offset: 2px;
  margin: 0 auto;
  display: block;
}

.markdown-here-wrapper table {
  width: 100%;
  max-width: 65em;
  border: 1px solid #dedede;
  margin: 15px auto;
  border-collapse: collapse;
  empty-cells: show;
}

.markdown-here-wrapper table th,
.markdown-here-wrapper table td {
  height: 35px;
  border: 1px solid #dedede;
  padding: 0 10px;
}

.markdown-here-wrapper table th {
  font-weight: bold;
  text-align: center !important;
  background: rgba(111,168,232,0.16);
  white-space: nowrap;
}

.markdown-here-wrapper table tbody tr:nth-child(2n) {
  background: rgba(111,168,232,0.08);
}

.markdown-here-wrapper table td:nth-child(1) {
  white-space: nowrap;
}

.markdown-here-wrapper table tr:hover {
  background: #efefef;
}

.markdown-here-wrapper .table-area {
  overflow: auto;
}

.markdown-here-wrapper code,
.markdown-here-wrapper tt {
  color: #C06A2F;
  margin: 0 2px;
  padding: 0 5px;
  white-space: nowrap;
  border: 1px solid #eaeaea;
  background-color: #f8f8f8;
  border-radius: 3px;
}

.markdown-here-wrapper pre code {
  margin: 0;
  padding: 0;
  white-space: pre;
  border: none;
  background: transparent;
  color: inherit;
}

.markdown-here-wrapper .highlight pre {
  background-color: #f8f8f8;
  border: 1px solid #cccccc;
  font-size: 13px;
  line-height: 19px;
  overflow: auto;
  padding: 6px 10px;
  border-radius: 3px;
}
