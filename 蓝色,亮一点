.markdown-here-wrapper {
  font-size: 16px;
  line-height: 1.75;
  letter-spacing: 0.01em;
  color: #2E3440;
  font-family: "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", "STSong", serif;
  word-wrap: break-word;
  max-width: 860px;
  margin: 0 auto;
}

/* Base */
.markdown-here-wrapper > *:first-child {
  margin-top: 0 !important;
}

.markdown-here-wrapper > *:last-child {
  margin-bottom: 0 !important;
}

.markdown-here-wrapper p,
.markdown-here-wrapper ul,
.markdown-here-wrapper ol,
.markdown-here-wrapper dl,
.markdown-here-wrapper blockquote,
.markdown-here-wrapper table,
.markdown-here-wrapper pre {
  margin: 1em 0;
}

.markdown-here-wrapper a {
  color: #5F8FD6;
  text-decoration: none;
  border-bottom: 1px solid rgba(95, 143, 214, 0.24);
}

.markdown-here-wrapper a:hover {
  border-bottom-color: #5F8FD6;
}

.markdown-here-wrapper strong,
.markdown-here-wrapper b {
  color: #5F8FD6;
  font-weight: 600;
}

.markdown-here-wrapper em,
.markdown-here-wrapper i {
  color: #2E3440;
}

/* Headings */
.markdown-here-wrapper h1,
.markdown-here-wrapper h2,
.markdown-here-wrapper h3,
.markdown-here-wrapper h4,
.markdown-here-wrapper h5,
.markdown-here-wrapper h6 {
  color: #2E3440;
  font-weight: 600;
  line-height: 1.35;
  margin: 1.4em 0 0.7em;
}

.markdown-here-wrapper h1 {
  font-size: 1.9em;
  text-align: center;
  letter-spacing: 0.03em;
  padding-bottom: 0.45em;
  border-bottom: 2px solid #5F8FD6;
}

.markdown-here-wrapper h2 {
  font-size: 1.45em;
  padding-left: 0.6em;
  border-left: 4px solid #5F8FD6;
}

.markdown-here-wrapper h3 {
  font-size: 1.2em;
  color: #5F8FD6;
}

.markdown-here-wrapper h4 {
  font-size: 1.05em;
}

.markdown-here-wrapper h5,
.markdown-here-wrapper h6 {
  font-size: 1em;
  opacity: 0.9;
}

/* Lists */
.markdown-here-wrapper ul,
.markdown-here-wrapper ol {
  padding-left: 1.4em;
}

.markdown-here-wrapper li {
  margin: 0.35em 0;
}

.markdown-here-wrapper li > ul,
.markdown-here-wrapper li > ol {
  margin: 0.35em 0;
}

/* Blockquote */
.markdown-here-wrapper blockquote {
  margin-left: 0;
  padding: 0.85em 1em;
  color: #4B5563;
  background: #F3F8FF;
  border-left: 4px solid #5F8FD6;
  border-radius: 2px;
}

.markdown-here-wrapper blockquote p:last-child {
  margin-bottom: 0;
}

/* Inline code */
.markdown-here-wrapper code {
  font-size: 0.92em;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, Courier, monospace;
  background: #F3F8FF;
  color: #5F8FD6;
  padding: 0.12em 0.38em;
  border-radius: 4px;
}

/* Code block */
.markdown-here-wrapper pre,
.markdown-here-wrapper pre code {
  font-size: 0.92em;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, Courier, monospace;
}

.markdown-here-wrapper pre {
  background: #F3F8FF;
  border: 1px solid rgba(95, 143, 214, 0.16);
  border-radius: 8px;
  padding: 0.95em 1em;
  overflow: auto;
  line-height: 1.6;
}

.markdown-here-wrapper pre code {
  background: transparent;
  color: #2E3440;
  padding: 0;
  border-radius: 0;
}

/* Table */
.markdown-here-wrapper table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.96em;
  background: #ffffff;
}

.markdown-here-wrapper th,
.markdown-here-wrapper td {
  padding: 0.7em 0.85em;
  border: 1px solid #dbe4ee;
  text-align: left;
}

.markdown-here-wrapper th {
  background: #5F8FD6;
  color: #ffffff;
  font-weight: 600;
}

.markdown-here-wrapper tr:nth-child(even) td {
  background: #F3F8FF;
}

/* Horizontal rule */
.markdown-here-wrapper hr {
  border: 0;
  border-top: 1px solid rgba(95, 143, 214, 0.24);
  margin: 2em 0;
}

/* Images */
.markdown-here-wrapper img {
  max-width: 100%;
  display: block;
  margin: 1em auto;
  border-radius: 6px;
}

/* Selection */
.markdown-here-wrapper ::selection {
  background: #F3F8FF;
}
