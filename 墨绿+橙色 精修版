.markdown-here-wrapper {
  color: #3e3e3e;
  font-size: 15px;
  line-height: 1.7;
  padding: 30px;
  box-sizing: border-box;
}

.markdown-here-wrapper p {
  letter-spacing: 1px !important;
  line-height: 1.7 !important;
  min-height: 1em !important;
  box-sizing: border-box !important;
  word-wrap: break-word !important;
  text-align: justify;
  margin: 20px 0 !important;
}

.markdown-here-wrapper blockquote {
  background: #f9f9f9;
  border-left: 5px solid #5599FF;
  margin: 1.5em 0;
  padding: 0.5em 10px;
  quotes: "\201C""\201D""\2018""\2019";
}

.markdown-here-wrapper blockquote:before {
  color: #5599FF;
  content: open-quote;
  font-size: 4em;
  line-height: 0.1em;
  margin-right: 0.25em;
  vertical-align: -0.4em;
}

.markdown-here-wrapper blockquote p {
  display: inline;
}

.markdown-here-wrapper strong {
  font-weight: 600;
  color: #FD5B03;
}

.markdown-here-wrapper em,
.markdown-here-wrapper i {
  color: #9955FF;
  font-style: italic;
}

.markdown-here-wrapper h1,
.markdown-here-wrapper h2,
.markdown-here-wrapper h3,
.markdown-here-wrapper h4,
.markdown-here-wrapper h5,
.markdown-here-wrapper h6 {
  margin: 20px 0;
  line-height: 1.2;
  text-align: left;
  font-weight: bold;
  padding-left: 15px;
  background: transparent !important;
  text-shadow: none !important;
  box-shadow: none !important;
  word-break: break-word;
  overflow-wrap: break-word;
}

.markdown-here-wrapper h1 {
  border-left: 6px solid #FF3333 !important;
  font-size: 24px !important;
}

.markdown-here-wrapper h2 {
  border-left: 4px solid #3A8619 !important;
  font-size: 20px !important;
}

.markdown-here-wrapper h3 {
  border-left: 4px solid #71BA51 !important;
  font-size: 17px !important;
}

.markdown-here-wrapper h4 {
  border-left: 4px solid #0174DF !important;
  font-size: 14px !important;
}

.markdown-here-wrapper h5 {
  border-left: 4px solid #58ACFA !important;
  font-size: 14px !important;
}

.markdown-here-wrapper h6 {
  border-left: 4px solid #58D3F7 !important;
  font-size: 14px !important;
}

.markdown-here-wrapper a {
  color: #4183C4 !important;
  text-decoration: none !important;
}

.markdown-here-wrapper ul,
.markdown-here-wrapper ol {
  padding-left: 30px;
}

.markdown-here-wrapper li {
  line-height: 24px;
}

.markdown-here-wrapper hr {
  height: 4px;
  padding: 0;
  margin: 16px 0;
  background-color: #e7e7e7;
  border: 0 none;
  overflow: hidden;
  box-sizing: content-box;
  border-bottom: 1px solid #ddd;
}

.markdown-here-wrapper pre {
  background: #f8f8f8 !important;
  border: 1px solid #eaeaea;
  border-radius: 3px;
  padding: 12px 13px;
  font-size: 13px;
  line-height: 1.6;
  color: #898989;
  overflow: auto;
  white-space: pre;
}

.markdown-here-wrapper img {
  max-width: 100%;
  height: auto;
  border: 2px solid #000000;
  padding: 2px;
  outline-offset: 2px;
  margin: 0 auto;
  display: block;
}

.markdown-here-wrapper table {
  width: 100%;
  max-width: 65em;
  border: 1px solid #dedede;
  margin: 15px auto;
  border-collapse: collapse;
  empty-cells: show;
}

.markdown-here-wrapper table th,
.markdown-here-wrapper table td {
  height: 35px;
  border: 1px solid #dedede;
  padding: 0 10px;
}

.markdown-here-wrapper table th {
  font-weight: bold;
  text-align: center !important;
  background: rgba(158,188,226,0.2);
  white-space: nowrap;
}

.markdown-here-wrapper table tbody tr:nth-child(2n) {
  background: rgba(158,188,226,0.12);
}

.markdown-here-wrapper table td:nth-child(1) {
  white-space: nowrap;
}

.markdown-here-wrapper table tr:hover {
  background: #efefef;
}

.markdown-here-wrapper .table-area {
  overflow: auto;
}

.markdown-here-wrapper code,
.markdown-here-wrapper tt {
  color: #e96900;
  margin: 0 2px;
  padding: 0 5px;
  white-space: nowrap;
  border: 1px solid #eaeaea;
  background-color: #f8f8f8;
  border-radius: 3px;
}

.markdown-here-wrapper pre code {
  margin: 0;
  padding: 0;
  white-space: pre;
  border: none;
  background: transparent;
  color: inherit;
}

.markdown-here-wrapper .highlight pre {
  background-color: #f8f8f8;
  border: 1px solid #cccccc;
  font-size: 13px;
  line-height: 19px;
  overflow: auto;
  padding: 6px 10px;
  border-radius: 3px;
}
